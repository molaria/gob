<?php

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_page().
 */
function gob_preprocess_page(array &$variables): void {
  // Welcome line under the menu bar for every logged-in member.
  // Varies per user, so the page render must too.
  $account = \Drupal::currentUser();
  if ($account->isAuthenticated()) {
    $variables['welcome_name'] = $account->getDisplayName();
  }
  $variables['#cache']['contexts'][] = 'user';
}

/**
 * Implements hook_preprocess_views_view().
 */
function gob_preprocess_views_view(array &$variables): void {
  // Search, sorting and per-voice numbering for the members table.
  if ($variables['view']->id() === 'medlemmar') {
    $variables['#attached']['library'][] = 'gob/members';
  }
}

/**
 * Implements hook_preprocess_image_widget().
 */
function gob_preprocess_image_widget(array &$variables): void {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}
