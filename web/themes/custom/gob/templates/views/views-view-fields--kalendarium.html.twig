{#
/**
 * @file
 * Kalendarium row: a native <details> accordion.
 * The first row (= next upcoming event) starts open via the counter field.
 *
 * Attendance state comes from the four-flag system:
 *   flagged   = deltar          flagged_2 = deltar_andrad
 *   flagged_1 = deltar_ej       flagged_3 = delta_ej_andrad
 * deltar without ändrad = attending, with ändrad = declined; the
 * deltar_ej pair mirrors that. No flags at all = no answer yet.
 */
#}
{% set node = row._entity %}
{% set signup = node.field_anmalan_mojlig.value == '1' %}
{% set is_first = fields.counter.content|render|striptags|trim == '1' %}
{# flag_flagged renders the string 0 or 1 #}
{% set f  = fields.flagged.content|render|striptags|trim == '1' %}
{% set f1 = fields.flagged_1.content|render|striptags|trim == '1' %}
{% set f2 = fields.flagged_2.content|render|striptags|trim == '1' %}
{% set f3 = fields.flagged_3.content|render|striptags|trim == '1' %}
{# Concert terms are named with an ISO date prefix (2026-10-24 ...),
   so sorting on the label gives chronological order, soonest first #}
{% set konserter = [] %}
{% for item in node.field_konsert %}
  {% if item.entity %}
    {% set konserter = konserter|merge([item.entity]) %}
  {% endif %}
{% endfor %}
{% set konserter = konserter|sort((a, b) => a.label > b.label ? 1 : -1) %}
{% if (f and not f2) or (f1 and f3) %}
  {% set state = 'attending' %}
{% elseif (f and f2) or (f1 and not f3) %}
  {% set state = 'declined' %}
{% else %}
  {% set state = 'none' %}
{% endif %}

<details class="cal-acc" {% if is_first %}open{% endif %}>
  <summary class="cal-acc__summary">
    {# Times as plain text: the field wrappers otherwise leak uneven
       whitespace around the dash. The end time is stored by time_field
       as seconds since midnight. #}
    {% set start_time = fields.field_datum_1.content|render|striptags|trim %}
    {% set end_seconds = node.field_sluttid.0.value %}
    {% set end_time = end_seconds is not null
      ? '%d.%02d'|format(end_seconds // 3600, (end_seconds % 3600) // 60)
      : '' %}
    <span class="cal-acc__date">
      <b>{{ fields.field_datum.content }}</b>
      <span class="cal-acc__time">{{ start_time }}{% if end_time %}&ndash;{{ end_time }}{% endif %}</span>
    </span>
    <span class="cal-acc__title">{{ node.label }}</span>
    {# Answering must never require expanding the row: state and buttons
       live in the always-visible summary. The flag links reload the page,
       so a stray details-toggle on click has no lasting effect. #}
    <span class="cal-acc__state">
      {% if signup %}
        {% if state == 'attending' %}
          <span class="chip chip--attending">Du är anmäld</span>
          {{ f ? fields.link_flag_2.content : fields.link_flag_3.content }}
        {% elseif state == 'declined' %}
          <span class="chip chip--declined">Du är avanmäld</span>
          {{ f ? fields.link_flag_2.content : fields.link_flag_3.content }}
        {% else %}
          <span class="cal-acc__ask">Kommer du?</span>
          {{ fields.link_flag.content }}
          {{ fields.link_flag_1.content }}
        {% endif %}
      {% endif %}
    </span>
  </summary>

  <div class="cal-acc__body">
    {% if node.field_information.value %}
      <div class="cal-acc__meta">{{ node.field_information.processed }}</div>
    {% endif %}

    {% if signup %}
      <div class="cal-acc__meta"><b class="cal-acc__meta-label">Fika:</b>
        {% if node.field_fikafixare|length > 0 %}
          <ul class="cal-acc__list">
            {% for item in node.field_fikafixare %}
              {% set fixer = item.entity %}
              {% if fixer %}
                <li>
                  <a href="mailto:{{ fixer.mail.value }}">{{ fixer.label }}</a>
                  {#- tel: link lets the phone offer both call and SMS -#}
                  {% if fixer.field_telefonnummer.value %} (<a href="tel:{{ fixer.field_telefonnummer.value|replace({' ': '', '-': ''}) }}">{{ fixer.field_telefonnummer.value }}</a>){% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% else %}
          ingen anmäld än - <a href="mailto:ingierdhallinger@gmail.com?subject=Fikalistan">kontakta Ingierd</a> (<a href="tel:0736502574">0736502574</a>) om du kan ta fikat
        {% endif %}
      </div>
    {% endif %}

    {% if konserter|length %}
      <div class="cal-acc__meta">
        <b class="cal-acc__meta-label">Noter och program:</b>
        <ul class="cal-acc__list">
          {% for term in konserter %}
            <li><a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': term.id}) }}">{{ term.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <span class="cal-acc__edit">{{ fields.edit_node.content }}</span>
  </div>
</details>
