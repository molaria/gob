{#
/**
 * @file
 * Public concert card on the front page: optional image, title and the
 * dedicated front page text (field_publik_text). Rendered for anonymous
 * visitors, so the internal field_information is deliberately never used
 * here - only what an admin wrote for the public reaches this template.
 */
#}
{% set node = row._entity %}
<article class="concert-card">
  {% if node.field_publik_bild.0.entity %}
    <img class="concert-card__img"
         src="{{ file_url(node.field_publik_bild.0.entity.uri.value) }}"
         alt="{{ node.field_publik_bild.0.alt }}" loading="lazy">
  {% endif %}
  <div class="concert-card__body">
  <h3 class="concert-card__title">{{ node.label }}</h3>
  {% if node.field_publik_text.0.value %}
    <div class="concert-card__info">{{ node.field_publik_text.0.processed }}</div>
  {% endif %}
  </div>
</article>
