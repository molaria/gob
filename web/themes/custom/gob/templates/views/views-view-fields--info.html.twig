{#
/**
 * @file
 * Info tile in the manner of Apple's "why buy here" cards: a small
 * coloured category label (the node title), the body's first sentence
 * as a big bold statement, the rest as quiet copy, and a large line
 * drawing anchored bottom right. The icon is picked from keywords in
 * the title, with the voice-part dots as fallback.
 */
#}
{% set node = row._entity %}
{% set titel = node.label %}
{% set t = titel|lower %}
{% set text = node.body.processed|striptags('<br>')|replace({'&nbsp;': ' '})|trim %}
{% set meningar = text|split('. ') %}
{% set statement = meningar|first %}
{% set rest = meningar|slice(1)|join('. ')|trim %}

{% if 'fika' in t %}{% set ikon = 'cup' %}
{% elseif 'avgift' in t %}{% set ikon = 'card' %}
{% elseif 'kläder' in t %}{% set ikon = 'shirt' %}
{% elseif 'pärm' in t %}{% set ikon = 'binder' %}
{% elseif 'lokal' in t %}{% set ikon = 'pin' %}
{% elseif 'noter' in t %}{% set ikon = 'note' %}
{% elseif 'övning' in t %}{% set ikon = 'clock' %}
{% else %}{% set ikon = 'dots' %}{% endif %}

<article class="info-tile">
  <p class="info-tile__label">{{ titel }}</p>
  <h2 class="info-tile__statement">{{ statement }}{% if statement|last != '.' and statement|last != '!' %}.{% endif %}</h2>
  {% if rest %}
    <p class="info-tile__text">{{ rest }}</p>
  {% endif %}

  <span class="info-tile__art" aria-hidden="true">
    {% if ikon == 'cup' %}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h24v10a10 10 0 0 1-10 10h-4A10 10 0 0 1 9 28V18Z"/><path d="M33 20h3a5 5 0 0 1 0 10h-3"/><path d="M16 12c0-2 2-2 2-4M23 12c0-2 2-2 2-4"/></svg>
    {% elseif ikon == 'card' %}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="12" width="36" height="24" rx="4"/><path d="M6 20h36"/><path d="M12 29h8"/></svg>
    {% elseif ikon == 'shirt' %}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8l-9 6 4 7 4-2v21h16V19l4 2 4-7-9-6a7 7 0 0 1-14 0Z"/></svg>
    {% elseif ikon == 'binder' %}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="6" width="28" height="36" rx="3"/><path d="M10 14h6M10 24h6M10 34h6"/><path d="M24 15v10l5-4 5 4V15"/></svg>
    {% elseif ikon == 'pin' %}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M24 42s-13-12.4-13-21a13 13 0 0 1 26 0c0 8.6-13 21-13 21Z"/><circle cx="24" cy="20" r="5"/></svg>
    {% elseif ikon == 'note' %}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 36V10l20-4v26"/><circle cx="13" cy="36" r="5"/><circle cx="33" cy="32" r="5"/></svg>
    {% elseif ikon == 'clock' %}
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="17"/><path d="M24 14v10l7 5"/></svg>
    {% else %}
      <svg viewBox="0 0 48 48" fill="currentColor"><circle cx="10" cy="24" r="5"/><circle cx="24" cy="24" r="5"/><circle cx="38" cy="24" r="5"/></svg>
    {% endif %}
  </span>
</article>
