{#
/**
 * @file
 * Front page: sell the choir. Hero with the new portrait, an automatic
 * "hear us live" section fed by the konserter view (public events
 * disappear by themselves once their date has passed), then the
 * editable presentation text from the node below.
 *
 * hero_photo and konserter are provided by gob_preprocess_page().
 */
#}
<header role="banner">
  <div class="site-nav">
    {{ page.header }}
    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="Meny">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </div>
</header>

{% if logged_in and welcome_name %}
  <div class="site-welcome">Välkommen {{ welcome_name }} till Kören Gott och Blandats intranätsidor.</div>
{% endif %}

<div class="layout-container">

  {{ page.highlighted }}

  <section class="hero">
    <div class="hero__text">
      <p class="hero__eyebrow">Kören Gott och Blandat · Equmeniakyrkan Betel Örebro</p>
      <h1 class="hero__slogan">Glädje, gemenskap och sång&shy;utveckling</h1>
      <p class="hero__lede">Vi i Kören Gott och Blandat har sjungit ihop sedan 1997. Vi är numera en kör för kvinnoröster och vi sjunger musik i många olika stilar, pop, rock och klassiskt. Ingen genre är främmande för oss. Medveten röstträning och alltid fika före sången. Nu finns det plats för fler röster.</p>
      <div class="hero__cta">
        <a class="button button--primary" href="https://www.bilda.nu/arr/1154066/damkoren-gott-och-blandat-intresseanmalan-557324">Sjung med oss</a>
        <a class="button" href="/info">Så funkar det</a>
        {% if konserter %}
          <a class="button" href="#konserter">Kom och lyssna</a>
        {% elseif not logged_in %}
          <a class="button" href="/user/login">Logga in som medlem</a>
        {% endif %}
      </div>
      <div class="hero__dots" aria-hidden="true">
        <i style="background:var(--dot-purple)"></i>
        <i style="background:var(--dot-red)"></i>
        <i style="background:var(--dot-gold)"></i>
        <i style="background:var(--dot-navy)"></i>
        <i style="background:var(--dot-gold)"></i>
        <i style="background:var(--dot-plum)"></i>
      </div>
    </div>
    {% if hero_photo %}
      <figure class="hero__photo">
        <img src="{{ hero_photo }}" alt="Mats-Olof Liljegren, körledare, framför Equmeniakyrkan Betel" fetchpriority="high">
        <figcaption>Mats-Olof Liljegren leder kören sedan 2012</figcaption>
      </figure>
    {% endif %}
  </section>

  {% if konserter %}
    <section class="concerts" id="konserter">
      <p class="hero__eyebrow">Kom och lyssna</p>
      <h2 class="concerts__title">Här hör du oss nästa gång</h2>
      <div class="concerts__list">
        {{ konserter }}
      </div>
    </section>
  {% endif %}

  <main role="main">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div class="layout-content">
      {{ page.content }}
    </div>{# /.layout-content #}

  </main>

  {% if page.footer %}
    <footer role="contentinfo">
      {{ page.footer }}
    </footer>
  {% endif %}

</div>{# /.layout-container #}
