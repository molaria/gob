<?php

/**
 * @file
 * Layout tweaks for GoB editing forms.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_ENTITY_TYPE_access() for taxonomy_term.
 *
 * Concert term pages list songs with listening, like the note
 * register, so they are for logged-in members only.
 */
function gob_form_taxonomy_term_access(EntityInterface $term, $operation, AccountInterface $account) {
  if ($operation === 'view' && $term->bundle() === 'datum_framforande' && $account->isAnonymous()) {
    return AccessResult::forbidden()->addCacheContexts(['user.roles:anonymous']);
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_form_alter().
 */
function gob_form_form_alter(array &$form, $form_state, $form_id) {
  // Start and end time side by side on the kalendarium form.
  if (in_array($form_id, ['node_kalendarium_form', 'node_kalendarium_edit_form'])) {
    $form['#attached']['library'][] = 'gob_form/kalendarium-form';
  }

  // Filled purple submit button on the auth pages, matching the site's
  // primary call-to-action style (see gob/auth, gob.theme).
  $auth_forms = ['user_login_form', 'user_pass', 'user_register_form', 'user_pass_reset'];
  if (in_array($form_id, $auth_forms, TRUE) && isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'][] = 'button--primary';
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for taxonomy_term.
 */
function gob_form_taxonomy_term_insert(EntityInterface $term) {
  _gob_form_sync_hepp($term);
}

/**
 * Implements hook_ENTITY_TYPE_update() for taxonomy_term.
 */
function gob_form_taxonomy_term_update(EntityInterface $term) {
  _gob_form_sync_hepp($term);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node.
 */
function gob_form_node_insert(EntityInterface $node) {
  _gob_form_sync_program($node);
}

/**
 * Implements hook_ENTITY_TYPE_update() for node.
 */
function gob_form_node_update(EntityInterface $node) {
  _gob_form_sync_program($node);
}

/**
 * Keeps the songs' field_hepp (the "Framförd" list) in step with the
 * concert term's field_program. Either side can be edited; whichever
 * one was just saved is treated as the source of truth for that save.
 * Newly added songs are appended last in field_program, since a song
 * picked from its own edit form carries no position - the manually
 * dragged order of the other songs is left untouched.
 */
function _gob_form_sync_hepp(EntityInterface $term): void {
  if ($term->bundle() !== 'datum_framforande' || !$term->hasField('field_program')) {
    return;
  }
  $tid = (int) $term->id();

  // Songs the term now points to, in programme order.
  $wanted = [];
  foreach ($term->get('field_program') as $item) {
    if ($item->target_id) {
      $wanted[(int) $item->target_id] = TRUE;
    }
  }

  // Songs that currently list this term in field_hepp.
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $has_now = $node_storage->getQuery()
    ->condition('type', 'musik')
    ->condition('field_hepp', $tid)
    ->accessCheck(FALSE)
    ->execute();
  $has_now = array_map('intval', $has_now);

  // Add the term to songs newly in the programme.
  $to_add = array_diff(array_keys($wanted), $has_now);
  // Remove the term from songs dropped from the programme.
  $to_remove = array_diff($has_now, array_keys($wanted));

  foreach ($node_storage->loadMultiple(array_merge($to_add, $to_remove)) as $node) {
    $nid = (int) $node->id();
    $values = array_filter(
      array_map(fn($i) => (int) $i['target_id'], $node->get('field_hepp')->getValue()),
      fn($v) => $v !== $tid
    );
    if (isset($wanted[$nid])) {
      $values[] = $tid;
    }
    $node->set('field_hepp', array_values(array_unique($values)));
    $node->save();
  }
}

/**
 * Reverse direction of _gob_form_sync_hepp(): keeps the concert terms'
 * field_program in step with a song's field_hepp when the song itself
 * is edited. Terminates without looping, because by the time a term
 * save re-triggers _gob_form_sync_hepp(), field_hepp already matches
 * what was just saved here, so that pass finds nothing left to change.
 */
function _gob_form_sync_program(EntityInterface $node): void {
  if ($node->bundle() !== 'musik' || !$node->hasField('field_hepp')) {
    return;
  }
  $nid = (int) $node->id();

  // Concert terms the song now points to.
  $wanted = [];
  foreach ($node->get('field_hepp') as $item) {
    if ($item->target_id) {
      $wanted[(int) $item->target_id] = TRUE;
    }
  }

  // Concert terms that currently list this song in field_program.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $has_now = $term_storage->getQuery()
    ->condition('vid', 'datum_framforande')
    ->condition('field_program', $nid)
    ->accessCheck(FALSE)
    ->execute();
  $has_now = array_map('intval', $has_now);

  // Add the song to concerts newly listed in field_hepp.
  $to_add = array_diff(array_keys($wanted), $has_now);
  // Remove the song from concerts dropped from field_hepp.
  $to_remove = array_diff($has_now, array_keys($wanted));

  foreach ($term_storage->loadMultiple(array_merge($to_add, $to_remove)) as $term) {
    $tid = (int) $term->id();
    $values = array_filter(
      array_map(fn($i) => (int) $i['target_id'], $term->get('field_program')->getValue()),
      fn($v) => $v !== $nid
    );
    if (isset($wanted[$tid])) {
      $values[] = $nid;
    }
    $term->set('field_program', array_values(array_unique($values)));
    $term->save();
  }
}

/**
 * Implements hook_deploy_NAME().
 *
 * One-off: creates or corrects the five datum_framforande terms for the
 * autumn 2026 concerts/rehearsals, then sets field_konsert on every
 * fall kalendarium event to the subset of those terms whose concert
 * date has not yet passed relative to that event's own date - a
 * concert's own event day still links to itself, but drops off every
 * later event once it has been performed.
 *
 * Matches terms by label/date, never by id: the taxonomy term ids
 * created here will not match the ones used while building this on
 * dev, since each environment has its own database.
 */
function gob_form_deploy_fall_2026_concert_program(): string {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  $wanted_terms = [
    '2026-10-24' => [
      'search' => 'Körfest',
      'label' => '2026-10-24 Körfest - Körsång 150 år i Equmeniakyrkan Betel',
    ],
    '2026-11-15' => ['search' => NULL, 'label' => '2026-11-15 Gudstjänst'],
    '2026-11-29' => ['search' => NULL, 'label' => '2026-11-29 Adventskör'],
    '2026-12-16' => ['search' => NULL, 'label' => '2026-12-16 Julkonsert'],
    '2027-04-10' => ['search' => NULL, 'label' => '2027-04-10 Musikalkonsert'],
  ];

  $term_ids = [];
  foreach ($wanted_terms as $date => $spec) {
    $tid = NULL;

    $exact = $term_storage->getQuery()
      ->condition('vid', 'datum_framforande')
      ->condition('name', $spec['label'])
      ->accessCheck(FALSE)
      ->execute();
    if ($exact) {
      $tid = (int) reset($exact);
    }
    elseif ($spec['search']) {
      // Catches a term already present but saved with the wrong date,
      // e.g. "2026-10-23 Körfest ..." instead of the correct 24th.
      $fuzzy = $term_storage->getQuery()
        ->condition('vid', 'datum_framforande')
        ->condition('name', $spec['search'], 'CONTAINS')
        ->accessCheck(FALSE)
        ->execute();
      if ($fuzzy) {
        $tid = (int) reset($fuzzy);
        $term_storage->load($tid)->setName($spec['label'])->save();
      }
    }

    if (!$tid) {
      $term = \Drupal\taxonomy\Entity\Term::create([
        'vid' => 'datum_framforande',
        'name' => $spec['label'],
      ]);
      $term->save();
      $tid = (int) $term->id();
    }
    $term_ids[$date] = $tid;
  }

  $nids = $node_storage->getQuery()
    ->condition('type', 'kalendarium')
    ->condition('field_datum', '2026-09-01T00:00:00', '>=')
    ->condition('field_datum', '2027-01-01T00:00:00', '<')
    ->accessCheck(FALSE)
    ->execute();

  $updated = 0;
  foreach ($node_storage->loadMultiple($nids) as $node) {
    $event_date = substr($node->get('field_datum')->value, 0, 10);
    $wanted = [];
    foreach ($term_ids as $date => $tid) {
      if ($date >= $event_date) {
        $wanted[] = $tid;
      }
    }
    $node->set('field_konsert', $wanted);
    $node->save();
    $updated++;
  }

  return count($term_ids) . ' konserttermer säkrade, ' . $updated . ' kalenderhändelser fick field_konsert satt.';
}
