<?php

/**
 * @file
 * Schema for the attendance table.
 */

/**
 * Implements hook_schema().
 */
function gob_attendance_schema(): array {
  $schema['gob_attendance'] = [
    'description' => 'Attendance answers. One row per member and event; no row means no answer yet.',
    'fields' => [
      'uid' => [
        'description' => 'Member user id.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'nid' => [
        'description' => 'Kalendarium node id.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'status' => [
        'description' => 'Either attending or declined.',
        'type' => 'varchar_ascii',
        'length' => 16,
        'not null' => TRUE,
      ],
      'changed' => [
        'description' => 'Unix timestamp of the latest answer.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['uid', 'nid'],
    'indexes' => [
      'nid' => ['nid'],
    ],
  ];
  return $schema;
}
