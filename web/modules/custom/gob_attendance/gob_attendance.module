<?php

/**
 * @file
 * Injects attendance state and answer URLs into the kalendarium rows.
 */

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * The kalendarium view has render caching disabled, so per-user values
 * are safe to inject here.
 */
function gob_attendance_preprocess_views_view_fields(array &$variables): void {
  if ($variables['view']->id() !== 'kalendarium') {
    return;
  }

  $node = $variables['row']->_entity;
  $account = \Drupal::currentUser();
  /** @var \Drupal\gob_attendance\AttendanceManager $manager */
  $manager = \Drupal::service('gob_attendance.manager');

  $variables['attendance_status'] = $manager->getStatus((int) $account->id(), (int) $node->id());

  $destination = \Drupal::destination()->getAsArray();
  foreach (['ja' => 'attend_url', 'nej' => 'decline_url'] as $answer => $key) {
    $variables[$key] = Url::fromRoute('gob_attendance.set', [
      'node' => $node->id(),
      'answer' => $answer,
    ], ['query' => $destination])->toString();
  }

  $variables['attendance_counts'] = $manager->getCounts((int) $node->id(), _gob_attendance_member_uids());

  // "Anmälda" länkar till samma post på närvarosidan, men bara för den
  // som faktiskt får se den sidan (behörigheten "access gob attending").
  if ($account->hasPermission('access gob attending')) {
    $narvaroPath = $variables['view']->current_display === 'page_2' ? '/gob/narvaro/tidigare' : '/gob/narvaro';
    $variables['narvaro_url'] = $narvaroPath . '#nid-' . $node->id();
  }
}

/**
 * Uids of active choir members - the roster "no response" is counted
 * against. Cached per request since every kalendarium row needs it.
 */
function _gob_attendance_member_uids(): array {
  $uids = &drupal_static(__FUNCTION__);
  if ($uids === NULL) {
    $uids = array_values(array_map('intval', \Drupal::entityQuery('user')
      ->condition('status', 1)
      ->condition('roles', 'aktiv_kormedlem')
      ->accessCheck(FALSE)
      ->execute()));
  }
  return $uids;
}
